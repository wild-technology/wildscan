/.idea
/.vscode
/.vs

# Local historical code is retained outside the published source tree.
/archive/

# Runtime marker files written by the RealityScan instance / ErrorWriter hook
# (namespaced per instance, e.g. errors_RS1.txt)
/modules/realityscan_interface/RS_CLI/Errors/errors*.txt
/modules/realityscan_interface/RS_CLI/Errors/progress*.txt
/modules/realityscan_interface/RS_CLI/Errors/results*.log
/modules/realityscan_interface/RS_CLI/Errors/*.lock
/modules/realityscan_interface/RS_CLI/Errors/*.dmp
/modules/realityscan_interface/RS_CLI/Errors/*.dmp.metadata
/modules/realityscan_interface/RS_CLI/Errors/expected_*.txt
/modules/realityscan_interface/RS_CLI/Models/

# Per-user persisted prompt defaults (see module_base/settings_store.py)
/rs_settings.json
/rs_settings.json.corrupt

# Python bytecode and profiling output
__pycache__/
*.pyc
*.lprof

# publish_cesium.py staging (local-frame mesh copies) and the ion probe
_cesium_local/
_probe_cesium/

# Packaging / build artifacts
*.egg-info/
build/
dist/
.venv/
venv/

# pytest
.pytest_cache/
